REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nba-fanbase-sentiment/0.1
ANTHROPIC_API_KEY=

# Optional. Left unset, Chroma opens data/chroma directly, which is fine when
# only one process touches it. Set these to talk to scripts/serve_chroma.sh
# instead - required once the app and the nightly sync can run at the same time,
# because embedded mode maps the index per-process and a concurrent writer can
# corrupt it.
CHROMA_HOST=
CHROMA_PORT=8000
